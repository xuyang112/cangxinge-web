# ============================================================
# mydaily-api 环境变量示例
# 使用：cp .env.example .env  然后按需修改
# ============================================================

# ---- 应用 ----
DEBUG=false

# ---- 数据库（PostgreSQL + asyncpg）----
# 本机 docker-compose 拉起 postgres 后默认即为此连接串
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mydaily
# 没有 PostgreSQL 时可用 SQLite 快速体验（本地开发/测试）：
# DATABASE_URL=sqlite+aiosqlite:///./mydaily.db

# ---- JWT（生产环境务必更换！）----
JWT_ACCESS_SECRET=change-me-access-secret-0123456789abcdef
JWT_REFRESH_SECRET=change-me-refresh-secret-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Cookie ----
# 生产环境走 HTTPS 时设为 true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---- CORS（逗号分隔）----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ---- 上传 ----
UPLOAD_DIR=public/uploads
MAX_UPLOAD_SIZE_MB=5

# ---- Cloudflare R2（可选；不配置则降级为本地 public/uploads）----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# 可选：自定义公网域名（如 https://cdn.example.com），不填则用默认 R2 域名
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRE_SECONDS=3600
